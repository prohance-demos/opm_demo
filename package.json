{
  "name": "prohance-pem-ui",
  "private": true,
  "version": "1.8.0",
  "type": "module",
  "description": "ProHance PEM dashboard prototype. Config-driven lenses, vendors, metrics and roles over a computed dataset.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "standalone": "npm run build && node scripts/build-standalone.mjs",
    "test:engine": "node --import \"data:text/javascript,process.env.PEM_TODAY=\\\"2026-09-15\\\"\" --experimental-strip-types tests/engine.test.ts",
    "test:ui": "playwright test",
    "verify": "npm run test:engine && npm run test:charts && npm run build && playwright test",
    "test:charts": "node --import \"data:text/javascript,process.env.PEM_TODAY=\\\"2026-09-15\\\"\" --experimental-strip-types tests/charts.test.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^26.6.2",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.9"
  }
}
